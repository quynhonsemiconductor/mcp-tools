{
  "name": "qnsc-mcp",
  "version": "0.1.0",
  "description": "QNSC MCP Tools Server",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhonsemiconductor/mcp-tools.git"
  },
  "type": "module",
  "bin": {
    "qnsc-mcp": "dist/bin/mcp.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "bun": ">=1.3.11",
    "npm": ">=10.9.2",
    "node": ">=22.14.1"
  },
  "scripts": {
    "preinstall": "node scripts/check-bun-version.cjs",
    "prepare": "husky",
    "build": "bun run scripts/build.ts",
    "build:prep:assets": "cp ./node_modules/gpt-3-encoder/encoder.json ./node_modules/gpt-3-encoder/encoder.json.tmp && cp manifest.json.tmpl manifest.json",
    "build:prep": "bun run build:prep:assets && bun run generate:tools && bun run generate:prompts && bun run generate:resources",
    "build:bundle": "bun run generate:bundles && bun run scripts/create-mcp-tars.ts && bun run scripts/generate-bundled-mcp-docs.ts",
    "build:binary": "bun run scripts/build.ts",
    "build:binary:fast": "NO_SECURITY_SCAN=true NO_BUNDLING=true bun run scripts/build.ts",
    "build:binary:fast:windows": "NO_SECURITY_SCAN=true NO_BUNDLING=true OUTFILE=qnsc-mcp.exe TARGET=bun-windows-x64 bun run scripts/build.ts",
    "build:binary:windows": "NO_SECURITY_SCAN=true OUTFILE=qnsc-mcp.exe TARGET=bun-windows-x64 bun run scripts/build.ts",
    "package:mcpb": "MCPB_ONLY=1 bun run scripts/build.ts",
    "build:installer": "cd installer && npm run build && npm run dist",
    "build:installer:all": "cd installer && npm run build && npm run dist:all",
    "dev": "bun run build:prep && environment=development bun run --watch src/mcp.ts --transportType httpStream",
    "dev:fast": "environment=development bun run --watch src/mcp.ts --transportType httpStream",
    "dev:nowatch": "environment=development bun run src/mcp.ts --transportType httpStream",
    "inspector": "bun x @modelcontextprotocol/inspector bun run --watch src/mcp.ts",
    "dev:web": "environment=development bun run --watch src/mcp.ts web",
    "debug": "bun run dev && bun run inspector",
    "lint-staged": "lint-staged",
    "typecheck": "bun x tsc --noEmit --skipLibCheck --pretty",
    "shield": "bun run build && bun x mcp-shield --path ./mcp.json",
    "generate:tools": "bun run scripts/generate-tool-loader.js",
    "generate:prompts": "bun run scripts/generate-prompt-loader.js",
    "generate:resources": "node scripts/generate-resource-loader.js",
    "generate:bundles": "bun run scripts/bundle-mcps.ts ${NO_SECURITY_SCAN:+--no-security-scan} ${VERBOSE:+--verbose}",
    "new:tool": "bun run scripts/new-tool.ts",
    "new:prompt": "bun run scripts/new-prompt.js",
    "new:resource": "node scripts/new-resource.js",
    "logs": "bun run src/mcp.ts view-logs",
    "logs:tail": "bun run src/mcp.ts view-logs --tail",
    "smoke-test": "bun run scripts/smoke-tests/cli-tests/index.ts",
    "docker:build": "docker build -f Dockerfile.test -t mcp:tests .",
    "docker:test": "docker run --volume=\"$(pwd)/src:/home/bun/app/src\" -e NODE_ENV=test mcp:tests bun test"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.ts": "tsc-files --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "0.0.4",
    "@aws-sdk/credential-providers": "3.948.0",
    "@aws-sdk/rds-signer": "3.948.0",
    "@inquirer/prompts": "7.10.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@napi-rs/keyring": "1.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.211.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-logs": "0.211.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "@types/luxon": "3.7.1",
    "@types/pg": "8.16.0",
    "@types/semver": "7.7.1",
    "@types/tar": "6.1.13",
    "@types/turndown": "5.0.6",
    "async-mutex": "0.5.0",
    "axios": "1.18.0",
    "axios-cookiejar-support": "6.0.5",
    "chalk": "5.6.2",
    "dotenv": "^16.6.1",
    "es-module-lexer": "1.7.0",
    "execa": "9.6.1",
    "express": "5.2.1",
    "gpt-3-encoder": "1.1.4",
    "graphql": "16.12.0",
    "graphql-request": "7.3.5",
    "handlebars": "4.7.9",
    "inquirer": "^9.3.8",
    "inquirer-select-pro": "1.0.0-alpha.9",
    "js-yaml": "4.3.2",
    "json-schema-to-zod": "2.7.0",
    "luxon": "3.7.2",
    "marked": "18.0.3",
    "mcp-shield": "https://github.com/brianantonelli/mcp-shield/archive/refs/tags/enhanced-reporting.tar.gz",
    "minimatch": "10.2.4",
    "node-cache": "^5.1.2",
    "node-html-markdown": "^1.3.0",
    "node-html-parser": "^7.0.1",
    "octokit": "5.0.5",
    "open": "10.2.0",
    "pg": "^8.16.3",
    "rimraf": "6.1.2",
    "semver": "7.7.3",
    "table": "^6.9.0",
    "tar": "7.5.21",
    "tough-cookie": "6.0.0",
    "turndown": "7.2.2",
    "vectra": "0.11.1",
    "yargs": "^17.7.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "1.2.0",
    "@babel/preset-env": "^7.28.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@modelcontextprotocol/inspector": "0.17.5",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "5.0.6",
    "@types/inquirer": "9.0.10",
    "@types/js-yaml": "4.0.9",
    "@types/marked": "6.0.0",
    "@types/minimatch": "6.0.0",
    "@types/string-similarity": "4.0.2",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@valibot/to-json-schema": "1.5.0",
    "@wong2/mcp-cli": "^1.13.0",
    "bun": "1.3.11",
    "bun-types": "1.3.11",
    "effect": "3.20.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fflate": "^0.8.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.7.4",
    "string-similarity": "4.0.4",
    "sury": "10.0.4",
    "tsc-files": "1.1.4",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.49.0"
  },
  "trustedDependencies": []
}