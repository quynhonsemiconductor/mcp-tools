{
  "name": "qnsc-mcp-installer",
  "version": "1.0.0",
  "description": "GUI installer for QNSC-MCP",
  "author": "QNSC",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "test": "bun test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder --win --mac"
  },
  "build": {
    "appId": "com.qnsc.qnsc-mcp-installer",
    "productName": "qnsc-mcp-installer",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "installer.nsh",
      "artifactName": "${productName}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^41.10.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0",
    "minimatch": "^10.2.4"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2"
  }
}
