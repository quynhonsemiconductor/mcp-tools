# Copy this file to `.env` and fill in what you need. `.env` is gitignored and is
# loaded automatically at startup (src/env.ts). Never commit real values.
#
# Nothing here is required to start the server. Each variable enables a group of
# tools; leave a line commented out and those tools are simply not offered.


# ─────────────────────────────────────────────────────────────────────────────
# GitHub — 92 tools. Pick ONE of the two options below.
# ─────────────────────────────────────────────────────────────────────────────

# Option A: the org's OAuth App (recommended for the team).
# Set these two and nothing else. On first use of a GitHub tool a browser opens,
# each person signs in as themselves, and their own token is stored in their own
# OS keyring. Nobody creates or pastes a personal token, and access can be
# revoked from the org. Both values come from the OAuth App registration; the
# callback URL must be http://localhost:8766/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Option B: a personal access token (fine for a quick local test).
# Classic PAT scopes needed for all 92 tools to work:
#   repo, read:org, read:user, user:email, workflow, project, security_events
# `project` matters because 19 Projects tools use the GraphQL API, and
# `security_events` because the 3 Dependabot tools need it.
# GITHUB_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Optional tool groups
# ─────────────────────────────────────────────────────────────────────────────

# k6 — 6 tools. A Grafana Cloud k6 API token. Talks to https://api.k6.io
# GRAFANA_K6_TOKEN=

# Google CrUX — 4 tools. Free key from the Chrome UX Report API.
# GOOGLE_CRUX_API_KEY=

# SwaggerHub — 2 tools.
# SWAGGER_HUB_API_KEY=

# Geocoding — 1 tool (location-to-coords).
# GEOCODE_MAPS_API_KEY=

# PostgreSQL — 4 tools. One set of four variables per database you want to
# reach, where <NAME> is a label you choose (e.g. LOCAL, STAGING).
# POSTGRES_PROFILE_<NAME>_HOST=
# POSTGRES_PROFILE_<NAME>_USER=
# POSTGRES_PROFILE_<NAME>_PASSWORD=
# POSTGRES_PROFILE_<NAME>_DATABASE=

# SharePoint — 56 bundled tools. Read by the bundled SharePoint MCP, not by this
# codebase. Requires an Azure app registration with a certificate.
# AZURE_APPLICATION_ID=
# AZURE_APPLICATION_CERTIFICATE_THUMBPRINT=
# AZURE_APPLICATION_CERTIFICATE_PASSWORD=
# M365_TENANT_ID=
