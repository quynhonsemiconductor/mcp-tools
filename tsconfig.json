{
  "compilerOptions": {
    // add Bun type definitions
    "types": ["bun-types"],

    // enable latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",

    // bundler
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,

    "allowJs": true, // allow importing `.js` from `.ts`
    "esModuleInterop": true,
    // Lets the version be imported from package.json as a value, so it is bundled
    // into the compiled binary rather than looked up on disk at runtime.
    "resolveJsonModule": true, // allow default imports for CommonJS modules

    // decorator support
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // best practices
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": [
    "installer","node_modules", "dist", "build", "src/**/*mock*", "frontend", "bundled-mcps", "bundled"]
}
